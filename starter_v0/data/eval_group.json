{
  "dataset_id": "day04_v2_research_group",
  "dataset_role": "group",
  "description": "Case do NHÓM tự viết thêm để cover thêm trường hợp. Mỗi case cần: id, phase='B', query HOẶC turns, failure_type (thuộc allowed_failure_types), và expect (tool_calls[...] hoặc no_tool=true). Nên kèm metadata.what_it_tests.",
  "allowed_failure_types": ["wrong_tool", "wrong_arg_value", "wrong_boundary", "unnecessary_tool", "out_of_scope", "missing_info"],
  "cases": [[
  {
    "id": "single_01",
    "phase": "B",
    "query": "Giá cổ phiếu của Apple hiện là bao nhiêu?",
    "failure_type": "wrong_tool",
    "expect": {
      "tool_calls": [{ "name": "market_tracker", "args": { "symbol": "AAPL" } }]
    },
    "metadata": { "what_it_tests": "Kiểm tra khả năng routing đến tool tài chính" }
  },
  {
    "id": "single_02",
    "phase": "B",
    "query": "Tóm tắt nội dung của trang https://openai.com/research",
    "failure_type": "wrong_tool",
    "expect": {
      "tool_calls": [{ "name": "fetch", "args": { "url": "https://openai.com/research" } }]
    },
    "metadata": { "what_it_tests": "Kiểm tra khả năng gọi tool fetch web" }
  },
  {
    "id": "single_03",
    "phase": "B",
    "query": "Tìm bài viết về AI mới nhất trên X",
    "failure_type": "wrong_arg_value",
    "expect": {
      "tool_calls": [{ "name": "social_search", "args": { "query": "AI", "search_type": "Latest" } }]
    },
    "metadata": { "what_it_tests": "Kiểm tra tham số tìm kiếm nâng cao" }
  },
  {
    "id": "single_04",
    "phase": "B",
    "query": "Đăng tin lên kênh Telegram của tôi",
    "failure_type": "missing_info",
    "expect": {
      "tool_calls": [{ "name": "clarify", "args": { "question": "Bạn vui lòng cung cấp nội dung tin nhắn muốn gửi và xác nhận hành động này nhé?" } }]
    },
    "metadata": { "what_it_tests": "Kiểm tra khả năng yêu cầu thêm thông tin (clarify)" }
  },
  {
    "id": "single_05",
    "phase": "B",
    "query": "Ai là CEO của NVIDIA?",
    "failure_type": "wrong_tool",
    "expect": {
      "tool_calls": [{ "name": "lookup", "args": { "topic": "general" } }]
    },
    "metadata": { "what_it_tests": "Kiểm tra routing đến tool tìm kiếm web" }
  },
  {
    "id": "multi_01",
    "phase": "B",
    "turns": [
      { "role": "user", "content": "Tìm giá cổ phiếu." },
      { "role": "assistant", "content": null, "tool_calls": [{ "name": "clarify", "args": { "question": "Bạn muốn xem giá của mã cổ phiếu nào?" } }] },
      { "role": "user", "content": "Mã là TSLA" }
    ],
    "failure_type": "wrong_tool",
    "expect": {
      "tool_calls": [{ "name": "market_tracker", "args": { "symbol": "TSLA" } }]
    },
    "metadata": { "what_it_tests": "Kiểm tra hội thoại đa lượt để thu thập tham số" }
  },
  {
    "id": "multi_02",
    "phase": "B",
    "turns": [
      { "role": "user", "content": "Gửi tin 'Hello' lên Telegram." },
      { "role": "assistant", "content": null, "tool_calls": [{ "name": "clarify", "args": { "question": "Bạn xác nhận gửi tin này không?" } }] },
      { "role": "user", "content": "Xác nhận gửi" }
    ],
    "failure_type": "wrong_arg_value",
    "expect": {
      "tool_calls": [{ "name": "send", "args": { "text": "Hello", "confirmed": true } }]
    },
    "metadata": { "what_it_tests": "Kiểm tra luồng xác nhận trước khi dùng action tool" }
  },
  {
    "id": "multi_03",
    "phase": "B",
    "turns": [
      { "role": "user", "content": "Tìm paper về ReAct." },
      { "role": "assistant", "content": null, "tool_calls": [{ "name": "papers", "args": { "query": "ReAct" } }] },
      { "role": "user", "content": "Tải paper đầu tiên về." }
    ],
    "failure_type": "wrong_arg_value",
    "expect": {
      "tool_calls": [{ "name": "paper_text", "args": { "paper_id": "..." } }]
    },
    "metadata": { "what_it_tests": "Kiểm tra sự tiếp nối thông tin giữa các turn" }
  },
  {
    "id": "multi_04",
    "phase": "B",
    "turns": [
      { "role": "user", "content": "Đọc nội dung link https://example.com" },
      { "role": "assistant", "content": null, "tool_calls": [{ "name": "fetch", "args": { "url": "https://example.com" } }] },
      { "role": "user", "content": "Tóm tắt thành markdown." }
    ],
    "failure_type": "wrong_tool",
    "expect": {
      "tool_calls": [{ "name": "format", "args": {} }]
    },
    "metadata": { "what_it_tests": "Kiểm tra khả năng định dạng dữ liệu sau khi fetch" }
  },
  {
    "id": "multi_05",
    "phase": "B",
    "turns": [
      { "role": "user", "content": "Tìm tin về VinAI." },
      { "role": "assistant", "content": null, "tool_calls": [{ "name": "social_search", "args": { "query": "VinAI" } }] },
      { "role": "user", "content": "Chỉ lấy bài top thôi." }
    ],
    "failure_type": "wrong_arg_value",
    "expect": {
      "tool_calls": [{ "name": "social_search", "args": { "query": "VinAI", "search_type": "Top" } }]
    },
    "metadata": { "what_it_tests": "Kiểm tra thay đổi tham số trong hội thoại" }
  }
]]
}
